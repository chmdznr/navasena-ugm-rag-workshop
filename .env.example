# Salin berkas ini menjadi .env lalu isi key-nya. Berkas .env tidak ikut di-commit.
# Buat key gratis di https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# "openrouter/free" memilih model gratis secara otomatis untuk setiap panggilan.
# Boleh diganti dengan id model tertentu, misalnya yang berakhiran ":free".
LLM_MODEL=openrouter/free

# Model pemeriksa untuk validator LLM di Guardrails AI. Kosongkan untuk memakai LLM_MODEL.
GUARD_MODEL=

# Penyamaran PII. Kosong = pola Indonesia saja (surel, nomor HP, NIK, NPWP, kartu).
# "presidio" menambahkan DetectPII dari Guardrails Hub; pasang dulu guardrails-ai-detect-pii.
PII_ENGINE=

# Port PostgreSQL di laptop (ubah bila 5433 sudah terpakai).
DB_PORT=5433

# --- Layanan versi framework (profil "service") ---
# Tingkat pengaman ditentukan server: off | rules | guardrails
GUARD_LEVEL=rules
# Pasangan kunci:peran, dipisah koma. Wajib diisi; layanan menolak start tanpa nilai ini.
# Dua kunci di bawah hanya contoh untuk workshop. Ganti sebelum layanan dibuka ke jaringan.
SERVICE_API_KEYS=kunci-publik-demo:public,kunci-internal-demo:internal
